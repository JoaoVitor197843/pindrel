#!/bin/sh
# A C compiler for <arch>-linux-musl made of zig, for the build of the TLS code (`ring` has C and assembly parts) without
# a cross gcc: zig carries the musl headers and libraries of every target. cc-rs takes a program and no arguments
# (CC_<target>), so it is called through zigcc-aarch64 / zigcc-x86_64:  zigcc <zig target> <compiler arguments...>
#  - cc-rs adds `--target=<rust triple>` when the compiler looks like clang; zig names its targets its own way, so it is dropped.
#  - UBSan is off: zig turns it on for unoptimised C, and a trap in the TLS code would only show up on the device.
target=${1:?zigcc: the zig target comes first}
shift
for a in "$@"; do
  shift
  case "$a" in --target=*) ;; *) set -- "$@" "$a" ;; esac
done
exec zig cc -target "$target" -fno-sanitize=undefined "$@"
