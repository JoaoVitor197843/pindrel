[Unit]
Description=Pindrel gateway (balanceador, limites por IP e anúncio na rede)
Documentation=https://github.com/JoaoVitor197843/pindrel
After=network-online.target
Wants=network-online.target

[Service]
User=pindrel-gateway
Group=pindrel-gateway
ExecStart=@BIN@ --config @CONF@
Restart=on-failure
RestartSec=3
# the pairing code and other warnings go to the journal: journalctl -u pindrel-gateway
StateDirectory=pindrel-gateway
# a port under 1024 (80, 443) works without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# the gateway is meant to stay in a few MB; this is a ceiling, not a target
MemoryMax=64M

[Install]
WantedBy=multi-user.target
