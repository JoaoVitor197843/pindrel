# Configuração do gateway do Pindrel (arquivo lido com --config). Linhas "CHAVE=valor"; # comenta.
# Uma variável de ambiente de verdade tem prioridade sobre este arquivo. Depois de editar, reinicie o gateway.

# Nome que aparece na rede e nos apps
SERVER_NAME=Pindrel
# Porta em que o gateway atende
GATEWAY_PORT=8080
# Onde estão as réplicas da API: ip:porta ou ip:porta-porta, separados por vírgula
UPSTREAMS=127.0.0.1:9000-9099

# Opcionais (os valores abaixo são os padrões):
#MDNS_ENABLED=true
#RATE_LIMIT_ENABLED=true
#MAX_CONNECTIONS=1024
# Atrás de um túnel (Cloudflare, tailscale serve): endereços do proxy e o cabeçalho com o IP do cliente
#TRUSTED_PROXIES=127.0.0.1,::1
#CLIENT_IP_HEADER=x-forwarded-for

# HTTPS com certificado próprio (o instalador já liga isto quando você marca a opção):
#TLS_AUTO=true
#TLS_DIR=C:\caminho\para\tls
#TLS_PORT=8443
