# Used by compose.yml (docker compose up). Every value has a default there.
PORT=8080

# Postgres
DB_USER=dev
# Required: compose refuses to start while this is empty
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pindrel
SSL_MODE=disable

# Auth
# Required: long random string, the same on every API instance
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# Registry
REGISTRATION_ENABLED=true

# Debug (enables /swagger/*)
DEBUG_MODE=false

# Go soft memory limit; keep below the pindrel container's mem_limit (128m in compose.yml)
GOMEMLIMIT=100MiB

# HTTPS (compose.tls.yml): port of the secure side, extra names for the certificate, what the plain port does
# TLS_PORT=8443
# TLS_SANS=
# HTTP_MODE=redirect
# PAIRING_MAX_ROOMS=6   # people who may be pairing at the same time (each with a room of their own)
# WS_ALLOWED_ORIGINS=
