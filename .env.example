# Used by compose.yml (docker compose up). Every value has a default there.
PORT=8080

# Postgres
DB_USER=dev
DB_PASSWORD=change_me
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pindrel
SSL_MODE=disable

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# Registry
REGISTRATION_ENABLED=true

# Debug (enables /swagger/*)
DEBUG_MODE=false

# Go soft memory limit; keep below the pindrel container's mem_limit (128m in compose.yml)
GOMEMLIMIT=100MiB

# HTTPS (compose.tls.yml): port of the secure side, extra names for the certificate, what the plain port does
# TLS_PORT=8443
# TLS_SANS=
# HTTP_MODE=redirect
# PAIRING_MASTER_CODES=1   # master codes of the gateway log good at the same time, 1 to 6 (each works once)
# PAIRING_MAX_ROOMS=6   # people who may be pairing at the same time (each with a room of their own)
# WS_ALLOWED_ORIGINS=
