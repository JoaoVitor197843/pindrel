# Configuração do servidor do Pindrel (a API e a página web). Uma linha "CHAVE=valor" por configuração; # comenta.
# Nada é expandido ($ é só um caractere) e um par de aspas em volta do valor é retirado.
# O instalador e o portátil criam o server.env sozinhos; este arquivo explica cada linha. Depois de editar o server.env,
# pare e inicie o servidor de novo.

# --- Rede ---
# Nome mostrado aos aparelhos (e anunciado na rede pelo gateway).
SERVER_NAME=Pindrel
# Porta da página e da API (1024 a 65535).
PORT=8080
# 127.0.0.1: só este computador alcança o servidor (use quando o Pindrel Gateway, na mesma máquina, é a porta de entrada).
# Vazio: todas as interfaces de rede.
#LISTEN_HOST=127.0.0.1
# Com o gateway na frente, ele limita os pedidos por endereço e o servidor não precisa fazer isso.
#IN_APP_RATE_LIMIT=false

# --- Página web e arquivos ---
# Pasta da página web (o instalador aponta para a pasta "public" do programa).
WEB_DIR=public
# Pasta das imagens, vídeos e PDFs enviados. Vazio desliga o envio de arquivos.
FILES_DIR=files
# Novos envios são recusados quando o disco tiver menos livre do que isto (em bytes; 2 GiB aqui).
FILES_MIN_FREE_BYTES=2147483648
# FILE_MAX_BYTES=1073741824          # um arquivo: 1 GiB
# FILE_QUOTA_BYTES=21474836480       # uma pessoa: 20 GiB

# --- Contas ---
REGISTRATION_ENABLED=true
# Segredo que assina as sessões: longo e aleatório (pindrel-server.exe --new-secret cria um). Trocar encerra todas as sessões.
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# --- Banco de dados ---
# true: o PostgreSQL que vem com o programa, guardado na pasta "pgdata" dos dados e acessível só deste computador.
# false: um PostgreSQL que já existe (preencha DB_HOST e o resto).
EMBEDDED_POSTGRES=true
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=pindrel
DB_PASSWORD=
DB_NAME=pindrel
# disable, allow, prefer, require, verify-ca ou verify-full
SSL_MODE=disable
# Conexões que o servidor mantém abertas com o banco.
#DB_MAX_CONNS=4
