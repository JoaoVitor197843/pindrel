# Server
PORT=8080

# Name shown to clients and advertised on the local network (mDNS)
SERVER_NAME=Plany

# Postgres
DB_USER=dev
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plany
SSL_MODE=disable
# Pool size per API instance (replicas multiply it)
DB_MAX_CONNS=4

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# Registry
REGISTRATION_ENABLED=true

# Debug (enables /swagger/*)
DEBUG_MODE=false

# Load balancer mode (compose.lb.yml sets it to false on the replicas)
IN_APP_RATE_LIMIT=true
