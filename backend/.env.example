# Server
PORT=8080

# Name shown to clients and advertised on the local network (mDNS)
SERVER_NAME=Pindrel

# Postgres
DB_USER=dev
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pindrel
SSL_MODE=disable
# Pool size per API instance (replicas multiply it)
DB_MAX_CONNS=4

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# Registry
REGISTRATION_ENABLED=true

# Debug (enables /swagger/*)
DEBUG_MODE=false

# Load balancer mode (compose.lb.yml sets it to false on the replicas)
IN_APP_RATE_LIMIT=true

# Files (uploaded in pieces, stored on disk). Leave FILES_DIR empty to turn the feature off.
# Sizes are in bytes. The defaults are for a server with a large disk (the Raspberry Pi with a 500 GB SSD).
FILES_DIR=
# FILE_MAX_BYTES=1073741824          # one file: 1 GiB
# FILE_QUOTA_BYTES=21474836480       # one person: 20 GiB
# FILES_MIN_FREE_BYTES=21474836480   # new uploads are refused when the disk has less free than this
# FILE_UPLOADS_MAX_OPEN=4            # uploads one person may have open at once
# FILE_UPLOAD_TTL=24h                # an upload with no news for this long is dropped
# FILE_ORPHAN_GRACE=168h             # a file nothing uses is removed after this
# FILE_LINK_TTL=10m                  # how long a download address works
# FILE_CHUNKS_PER_MIN=600            # pieces one person may send per minute

# Behind a proxy on this host (Cloudflare Tunnel, tailscale serve) the in-app limits would count the proxy as the only
# client. List the proxy here and name the ONE header it fills; nothing is believed from anyone else.
#   Cloudflare Tunnel: TRUSTED_PROXIES=127.0.0.1,::1  CLIENT_IP_HEADER=CF-Connecting-IP
#   tailscale serve:   TRUSTED_PROXIES=127.0.0.1,::1  (X-Forwarded-For is the default header)
#TRUSTED_PROXIES=
#CLIENT_IP_HEADER=X-Forwarded-For
