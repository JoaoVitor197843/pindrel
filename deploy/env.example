# Configuração do Plany num servidor de produção (o Raspberry Pi). Copie para `.env` NA RAIZ do repositório:
#   cp deploy/env.example .env && nano .env
#
# É o .env da RAIZ que vale, não o backend/.env: o docker compose lê este arquivo para preencher os
# ${...} do compose.yml, e essas entradas têm prioridade sobre o backend/.env. Por isso aqui NÃO há DB_HOST
# (o compose usa o serviço `postgres`; o `localhost` do backend/.env.example é para desenvolvimento).

# Porta do Plany na rede (a do gateway, a que os clientes e o mDNS usam). Escolha uma livre: `ss -ltn`
# (no Pi do homelab a 8086 é do Vaultwarden e a 8080 é a do Plany)
PORT=8080

# Nome que aparece para os clientes e no anúncio mDNS
SERVER_NAME=Plany

# Postgres (a senha vale na primeira criação do volume; trocá-la depois não muda a do banco já criado)
DB_USER=plany
DB_PASSWORD=troque-por-uma-senha-longa
DB_NAME=plany

# Troque: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

# Cadastro aberto a quem acessa o servidor
REGISTRATION_ENABLED=true

# Atrás de um túnel ou proxy NESTA máquina (Cloudflare Tunnel, tailscale serve), para o limite por IP contar cada
# cliente e não o túnel inteiro. Só vale o cabeçalho de CLIENT_IP_HEADER, e só de quem estiver em TRUSTED_PROXIES.
# Cloudflare Tunnel:  TRUSTED_PROXIES=127.0.0.1,::1   CLIENT_IP_HEADER=cf-connecting-ip
# tailscale serve:    TRUSTED_PROXIES=127.0.0.1,::1   (o cabeçalho padrão é x-forwarded-for)
#TRUSTED_PROXIES=
#CLIENT_IP_HEADER=x-forwarded-for
