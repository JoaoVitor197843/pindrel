# Plany configuration on a production server (the Raspberry Pi). Copy to `.env` AT THE REPOSITORY ROOT:
#   cp deploy/env.example .env && nano .env
#
# The ROOT .env is the one that counts, not backend/.env: docker compose reads this file to fill the
# ${...} of compose.yml, and those entries take priority over backend/.env. That is why there is NO DB_HOST here
# (compose uses the `postgres` service; the `localhost` in backend/.env.example is for development).

# Plany's port on the network (the gateway's, the one clients and mDNS use). Pick a free one: `ss -ltn`
# (on the homelab Pi, 8086 is Vaultwarden's and 8080 is Plany's)
PORT=8080

# Name shown to clients and in the mDNS announcement
SERVER_NAME=Plany

# Postgres (the password counts on the volume's first creation; changing it later does not change the already created database's)
DB_USER=plany
DB_PASSWORD=troque-por-uma-senha-longa
DB_NAME=plany

# Change it: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

# Registration open to anyone who reaches the server
REGISTRATION_ENABLED=true

# Behind a tunnel or proxy ON THIS machine (Cloudflare Tunnel, tailscale serve), so the per-IP limit counts each
# client and not the whole tunnel. Only the CLIENT_IP_HEADER header counts, and only from whoever is in TRUSTED_PROXIES.
# Cloudflare Tunnel:  TRUSTED_PROXIES=127.0.0.1,::1   CLIENT_IP_HEADER=cf-connecting-ip
# tailscale serve:    TRUSTED_PROXIES=127.0.0.1,::1   (the default header is x-forwarded-for)
# (the gateway and, without it, the API read the same two variables)
#TRUSTED_PROXIES=
#CLIENT_IP_HEADER=x-forwarded-for
